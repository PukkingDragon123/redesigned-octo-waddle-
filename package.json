{
  "name": "skysong",
  "version": "1.0.0",
  "private": true,
  "description": "SKYSONG \u2014 a cinematic 3D fantasy adventure about a baby sky whale migrating with its herd across a magical sky.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.skysong.game",
    "productName": "SKYSONG",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SKYSONG-win-x64.${ext}"
    }
  }
}
